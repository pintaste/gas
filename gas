    else:
        numbers = [
            int(n)
            for n in (seq.get("sequence") or sorted(int(k) for k in seq["accounts"]))
            if str(n) in seq["accounts"]
        ]

    if not usage_network_enabled() and not as_json:
        info(f"{DIM}usage network disabled (GAS_USAGE=0); showing cache if any{RESET}")

    usages = fetch_all_usages(seq, force=force, numbers=numbers)

    if as_json:
        payload = {str(n): usages.get(n) for n in numbers}
        print(json.dumps(payload, indent=2, ensure_ascii=False))
