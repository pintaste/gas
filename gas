    info(f"{BOLD}Credit Usage{RESET}")
    info("============")
    live_email = get_current_email()
    active_num = account_exists_email(live_email, seq) if live_email else None
    if active_num is None:
        active_num = seq.get("activeAccountNumber")

    need_relogin: list[int] = []
    for num in numbers:
        acc = seq["accounts"].get(str(num)) or {}
        email = acc.get("email") or "?"
        prof = acc.get("profile")
        prof_s = f" [{prof}]" if prof else ""
        mark = (
            f" {GREEN}(active){RESET}"
            if active_num is not None and int(num) == int(active_num)
            else ""
        )
        usage = usages.get(num)
        health = inspect_account_auth(num, seq)
        info()
        info(f"{BOLD}Account-{num}{RESET}: {email}{prof_s}{mark}")
        # Local auth line first when something is wrong
        if health.get("status") not in ("ok", "unknown") or account_needs_relogin(
            usage, health
        ):
            st = health.get("status")
            exp = health.get("expires_at")
            exp_s = f"  expires_at={exp}" if exp else ""
            if account_needs_relogin(usage, health) or st in (
                "missing",
                "no_refresh",
                "expired",
            ):
                if account_needs_relogin(usage, health):
                    info(
                        f"  Auth:            {RED}needs re-login{RESET} "
                        f"{DIM}(local={st}{exp_s}){RESET}"
                    )
                else:
                    info(f"  Auth:            {YELLOW}{st}{RESET}{DIM}{exp_s}{RESET}")
        for line in format_usage_detail(usage, indent="  "):
            info(line)
        if account_needs_relogin(usage, health):
            need_relogin.append(int(num))

    for line in format_relogin_footer(need_relogin, seq):
        info(line)

    info()
    info(f"{DIM}Source: cli-chat-proxy billing · cache TTL {_usage_ttl():.0f}s · gas usage --refresh{RESET}")


def cmd_refresh(args: argparse.Namespace) -> None:
    """Proactively refresh OIDC tokens for managed accounts (write-back)."""
    ensure_layout()
    seq = read_sequence()
    if not seq["accounts"]:
        info("No accounts are managed yet.")
        return

    force = bool(getattr(args, "force", False))
    identifier = getattr(args, "identifier", None)
    if identifier:
        num = resolve_account_identifier(identifier, seq)
        if num is None:
            die(f"no account found matching: {identifier}")
        numbers = [int(num)]
    else:
        numbers = [
            int(n)
            for n in (seq.get("sequence") or sorted(int(k) for k in seq["accounts"]))
            if str(n) in seq["accounts"]
        ]

    # Live mirror first (active slot gets Grok's latest tokens for free)
    synced = sync_live_to_managed(seq)
    if synced is not None and not SILENT:
        info(f"{DIM}synced live → Account-{synced}{RESET}")

    need: list[int] = []
    info(f"{BOLD}Token refresh{RESET}")
    for num in numbers:
        acc = seq["accounts"].get(str(num)) or {}
        email = acc.get("email") or "?"
        status, detail = refresh_account_tokens(num, seq, force=force)
        if status == "ok":
            info(f"  {num}: {email}  {GREEN}ok{RESET}  {DIM}{detail or ''}{RESET}")
        elif status == "refreshed":
            info(f"  {num}: {email}  {GREEN}refreshed{RESET}  {DIM}exp {detail or '?'}{RESET}")
        elif status == "missing":
            info(f"  {num}: {email}  {RED}missing{RESET}  {DIM}{detail or ''}{RESET}")
            need.append(num)
        else:
            info(f"  {num}: {email}  {RED}re-login{RESET}  {DIM}{detail or ''}{RESET}")
            need.append(num)

    for line in format_relogin_footer(need, seq):
        info(line)
    if need:
        raise SystemExit(1)


def cmd_check(_: argparse.Namespace) -> None:
    ensure_layout()
    seq = read_sequence()
    if not seq["accounts"]:
        info("No accounts are managed yet. Nothing to check.")
        return

    issues = 0
    info(f"{BOLD}Backup Integrity Check{RESET}")
    info("======================")
    info()

    if SEQUENCE_PATH.exists():
        try:
            json.loads(SEQUENCE_PATH.read_text(encoding="utf-8"))
            info("[OK] sequence.json is valid JSON")
        except json.JSONDecodeError:
            info("[FAIL] sequence.json is invalid JSON")
            issues += 1
    else:
        info("[FAIL] sequence.json missing")
        issues += 1

    for num in seq.get("sequence") or sorted(int(k) for k in seq["accounts"]):
        acc = seq["accounts"].get(str(num), {})
        email = acc.get("email") or "?"
        info()
        info(f"Account-{num} ({email}):")
        ap = account_auth_path(num)
        if ap.exists():
            try:
                data = json.loads(ap.read_text(encoding="utf-8"))
                if not isinstance(data, dict) or not data:
                    info("  [FAIL] auth backup empty or not an object")
                    issues += 1
                else:
                    info("  [OK] auth backup is valid JSON")
                    ident = auth_identity(data)
                    if ident.get("email") and email != "?" and ident["email"] != email:
                        info(
                            f"  [WARN] email mismatch: sequence={email} auth={ident['email']}"
                        )
                        issues += 1
            except json.JSONDecodeError:
                info("  [FAIL] auth backup is invalid JSON")
                issues += 1
            mode = oct(ap.stat().st_mode & 0o777)
            if mode == "0o600":
                info("  [OK] auth file permissions: 600")
            else:
                info(f"  [WARN] auth file permissions: {mode[2:]} (expected 600)")
                issues += 1
        else:
            info(f"  [FAIL] auth backup missing: {ap}")
            issues += 1

    info()
    try:
        dmode = oct(SWITCH_DIR.stat().st_mode & 0o777)
        if dmode == "0o700":
            info("[OK] switch directory permissions: 700")
        else:
            info(f"[WARN] switch directory permissions: {dmode[2:]} (expected 700)")
            issues += 1
    except OSError:
        pass

    info()
    if AUTH_PATH.exists():
        try:
            json.loads(AUTH_PATH.read_text(encoding="utf-8"))
            info("[OK] live auth.json is valid JSON")
        except json.JSONDecodeError:
            info("[FAIL] live auth.json is invalid JSON")
            issues += 1
    else:
        info("[WARN] live auth.json missing (not logged in)")

    info()
    if issues == 0:
        info("All checks passed.")
    else:
        info(f"{issues} issue(s) found.")
        raise SystemExit(1)


def cmd_dir(args: argparse.Namespace) -> None:
    ensure_layout()
    seq = read_sequence()
    if not seq["accounts"]:
        die("no accounts managed yet. Run: gas add")

    parts: list[str] = list(args.parts or [])
    if len(parts) == 1:
        dir_path = Path.cwd().resolve()
        account_id = parts[0]
    elif len(parts) >= 2:
        dir_path = Path(parts[0]).expanduser().resolve()
        account_id = parts[1]
    else:
        die("usage: gas dir [directory] <num|email|profile>")

    if not dir_path.is_dir():
        die(f"directory does not exist: {dir_path}")

    num = resolve_account_identifier(account_id, seq)
    if num is None:
        die(f"account '{account_id}' not found")

    mapping = read_json(DIR_ACCOUNTS_PATH) if DIR_ACCOUNTS_PATH.exists() else {}
    mapping.setdefault("dirs", {})
    mapping["dirs"][str(dir_path)] = int(num)
    write_json(DIR_ACCOUNTS_PATH, mapping)
    email = seq["accounts"][str(num)].get("email")
    info(f"{GREEN}✓{RESET} mapped {dir_path} → Account-{num} ({email})")


def cmd_auto(_: argparse.Namespace) -> None:
    ensure_layout()
    if not DIR_ACCOUNTS_PATH.exists():
        die("no directory mappings. Run: gas dir <path> <account>")

    mapping = read_json(DIR_ACCOUNTS_PATH)
    dirs: dict = mapping.get("dirs") or {}
    cwd = Path.cwd().resolve()

    best = None
    best_len = -1
    for d, num in dirs.items():
        try:
            base = Path(d).resolve()
        except OSError:
            continue
        try:
            cwd.relative_to(base)
            n = len(base.parts)
            if n > best_len:
                best_len = n
                best = int(num)
        except ValueError:
            continue

    if best is None:
        die(f"no account mapping for {cwd}")
    perform_switch(best)


def cmd_config_dir(args: argparse.Namespace) -> None:
    """Materialize isolated GROK_HOME for an account and print export line."""
    ensure_layout()
    seq = read_sequence()
    num = resolve_account_identifier(args.identifier, seq)
    if num is None:
        die(f"account '{args.identifier}' not found")
    dest = Path(args.dest).expanduser() if args.dest else None
    home = materialize_account_home(num, dest)
    email = seq["accounts"][str(num)].get("email")
    info(f"{GREEN}✓{RESET} Account-{num} ({email}) → {home}")
    # Always print machine-readable export last (for eval)
    print(f'export GROK_HOME="{home}"')


def cmd_exec(args: argparse.Namespace) -> None:
    """Run a command with GROK_HOME pointed at an isolated account dir."""
    ensure_layout()
    seq = read_sequence()
    num = resolve_account_identifier(args.identifier, seq)
    if num is None:
        die(f"account '{args.identifier}' not found")

    cmd = list(args.command or [])
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if not cmd:
        die("usage: gas exec <account> [--dir PATH] -- <command> [args...]")

    dest = Path(args.dest).expanduser() if args.dest else None
    if DRY_RUN:
        email = seq["accounts"][str(num)].get("email")
        info(f"[DRY RUN] Would materialize Account-{num} ({email}) and run: {' '.join(cmd)}")
        return

    home = materialize_account_home(num, dest)
    env = os.environ.copy()
    env["GROK_HOME"] = str(home)
    # Avoid gas test override leaking into child
    env.pop("GROK_DIR", None)
    if not SILENT:
        print(f"{DIM}GROK_HOME={home}{RESET}", file=sys.stderr)
    try:
        raise SystemExit(subprocess.call(cmd, env=env))
    except FileNotFoundError:
        die(f"command not found: {cmd[0]}")


def cmd_whoami(_: argparse.Namespace) -> None:
    ensure_layout()
    email = get_current_email()
    if not email:
        print("not logged in")
        raise SystemExit(1)
    print(email)


def cmd_version(_: argparse.Namespace) -> None:
    print(f"gas {__version__}")


def cmd_help(parser: argparse.ArgumentParser) -> None:
    parser.print_help()


# ── legacy aliases ──────────────────────────────────────────────────────────


def cmd_save_legacy(args: argparse.Namespace) -> None:
    ensure_layout()
    cmd_add(argparse.Namespace())
    if args.name:
        seq = read_sequence()
        num = seq.get("activeAccountNumber")
        if num is None:
            return
        name = valid_profile_name(args.name)
        for key, acc in seq["accounts"].items():
            if acc.get("profile") == name and int(key) != int(num):
                die(f"profile name {name!r} already used by Account-{key}")
        seq["accounts"][str(num)]["profile"] = name
        write_sequence(seq)
        info(f"  profile: {name}")


def cmd_use_legacy(args: argparse.Namespace) -> None:
    cmd_to(argparse.Namespace(identifier=args.name))


def cmd_rename_legacy(args: argparse.Namespace) -> None:
    ensure_layout()
    seq = read_sequence()
    num = resolve_account_identifier(args.old, seq)
    if num is None:
        die(f"account '{args.old}' not found")
    name = valid_profile_name(args.new)
    for key, acc in seq["accounts"].items():
        if acc.get("profile") == name and int(key) != int(num):
            die(f"profile name {name!r} already used by Account-{key}")
    seq["accounts"][str(num)]["profile"] = name
    write_sequence(seq)
    info(f"{GREEN}✓{RESET} Account-{num} profile → {name}")


# ── parser / main ───────────────────────────────────────────────────────────


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="gas",
        description="Multi-Account Switcher for Grok CLI (ccs-style)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
examples:
  gas add                         # capture current login
  gas ls / gas sw / gas to 2
  gas -n sw                       # dry-run
  gas profile 1 work
  gas dir ~/proj 1 && gas auto
  gas exec 2 -- grok -p "hi"      # isolated via GROK_HOME
  gas config-dir 2                # print export GROK_HOME=...
  gas check / status / stats / usage / refresh

  # second account:
  gas add && grok logout && grok login && gas add && gas sw

environment:
  GSS_HOME / GAS_HOME   store dir (default ~/.grok-switch)
  GROK_HOME / GROK_DIR  live Grok config (default ~/.grok)
  GAS_SILENT=1          quiet mode (for scripts)
  GAS_USAGE=0           disable SuperGrok usage network fetch
  GAS_USAGE_TTL         usage cache seconds (default 120)
  GAS_REFRESH_SKEW_SECS refresh this many seconds before access expiry (default 1800)
  NO_COLOR              disable colors
""",
    )
    p.add_argument("-V", "--version", action="version", version=f"gas {__version__}")
    p.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="show what would happen without making changes",
    )

    sub = p.add_subparsers(dest="cmd")

    sub.add_parser("add", help="add/update current login as managed account")

    sp = sub.add_parser("ls", aliases=["list"], help="list managed accounts (+ SuperGrok usage)")
    sp.add_argument(
        "--no-usage",
        action="store_true",
        help="skip network credit-usage fetch",
    )
    sp.add_argument(
        "--refresh",
        action="store_true",
        help="force refresh usage cache",
    )

    sub.add_parser("sw", help="rotate to next account in sequence")
    sp = sub.add_parser("to", help="switch to account by number, email, or profile")
    sp.add_argument("identifier")

    sp = sub.add_parser("profile", help="set friendly profile name")
    sp.add_argument("identifier")
    sp.add_argument("name")

    sp = sub.add_parser("rm", aliases=["remove", "delete"], help="remove managed account")
    sp.add_argument("identifier")
    sp.add_argument("-y", "--yes", action="store_true")

    sp = sub.add_parser("dir", help="map directory → account")
    sp.add_argument("parts", nargs="+", metavar="ARG", help="[directory] <account>")

    sub.add_parser("auto", help="switch based on cwd mapping")

    sp = sub.add_parser("exec", help="run command as account (isolated GROK_HOME)")
    sp.add_argument("identifier")
    sp.add_argument("--dir", dest="dest", help="custom isolated dir path")
    sp.add_argument(
        "command",
        nargs=argparse.REMAINDER,
        help="command after optional --",
    )

    sp = sub.add_parser("config-dir", help="materialize isolated GROK_HOME and print export")
    sp.add_argument("identifier")
    sp.add_argument("dest", nargs="?", help="optional destination path")

    sub.add_parser("check", help="verify backup integrity")

    sp = sub.add_parser(
        "status",
        aliases=["current"],
        help="current account + token expiry + usage",
    )
    sp.add_argument("--refresh", action="store_true", help="force refresh usage cache")

    sub.add_parser("stats", help="per-account switch statistics (local)")

    sp = sub.add_parser(
        "refresh",
        help="refresh OIDC tokens for managed accounts (write-back)",
    )
    sp.add_argument("identifier", nargs="?", help="optional account filter")
    sp.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="refresh even if access token still valid",
    )

    sp = sub.add_parser(
        "usage",
        aliases=["cost"],
        help="SuperGrok credit usage (weekly + monthly)",
    )
    sp.add_argument("identifier", nargs="?", help="optional account number/email/profile")
    sp.add_argument("--refresh", action="store_true", help="force refresh usage cache")
    sp.add_argument("--json", dest="as_json", action="store_true", help="machine-readable JSON")

    sub.add_parser("whoami", help="print active email")
    sub.add_parser("version", help="print version")
    sub.add_parser("help", help="show help")

    sp = sub.add_parser("save", help="(legacy) add + optional profile")
    sp.add_argument("name", nargs="?")
    sp = sub.add_parser("use", aliases=["switch"], help="(legacy) → to")
    sp.add_argument("name")
    sp = sub.add_parser("rename", help="(legacy) rename profile")
    sp.add_argument("old")
    sp.add_argument("new")

    return p


def main(argv: list | None = None) -> None:
    global DRY_RUN
    parser = build_parser()
    args = parser.parse_args(argv)
    DRY_RUN = bool(getattr(args, "dry_run", False))

    cmd = args.cmd
    if cmd is None:
        cmd_ls(argparse.Namespace(no_usage=False, refresh=False))
        return
    if cmd == "help":
        cmd_help(parser)
        return

    handlers: dict[str, Any] = {
        "add": cmd_add,
        "ls": cmd_ls,
        "list": cmd_ls,
        "sw": cmd_sw,
        "to": cmd_to,
        "profile": cmd_profile,
        "rm": cmd_rm,
        "remove": cmd_rm,
        "delete": cmd_rm,
        "dir": cmd_dir,
        "auto": cmd_auto,
        "exec": cmd_exec,
        "config-dir": cmd_config_dir,
        "check": cmd_check,
        "status": cmd_status,
        "current": cmd_status,
        "stats": cmd_stats,
        "refresh": cmd_refresh,
        "usage": cmd_usage,
        "cost": cmd_usage,
        "whoami": cmd_whoami,
        "version": cmd_version,
        "save": cmd_save_legacy,
        "use": cmd_use_legacy,
        "switch": cmd_use_legacy,
        "rename": cmd_rename_legacy,
    }
    handler = handlers.get(cmd)
    if not handler:
        parser.print_help()
        raise SystemExit(2)
    handler(args)


if __name__ == "__main__":
    main()
